# Connect to Supabase via connection pooling.
#
# Nota: en este proyecto el límite real de conexiones lo aplica
# `lib/db/prisma.ts` pasando `max: 3` a `PrismaPg` (node-postgres ignora
# `connection_limit` / `pool_timeout` del DSN). Los dejamos abajo a modo
# de documentación por si en el futuro se migra al engine clásico de
# Prisma, que sí los lee.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20"

# Direct connection for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# Contraseña con la que se hashean los usuarios creados por `prisma db seed`.
# Si no se define, se usa el fallback 'dev-only-cambiar-en-produccion'.
SEED_PASSWORD=pon-aqui-una-contraseña-robusta-para-el-seed
