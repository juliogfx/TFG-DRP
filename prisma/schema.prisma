// =============================================================================
// schema.prisma — TFG-DRP  v4.2
// Sistema de Gestión de Dispositivos de Riesgos Previsibles
// Stack: Next.js 14 + TypeScript + Prisma 7 + Supabase (PostgreSQL)
//
// CHANGELOG v4.2 (09-may-2026):
//   + Tabla EquipoCatalogo — catálogo de equipos deportivos
//   + Campo Evento.equipoLocalId FK → EquipoCatalogo
//   + Campo Evento.equipoVisitanteId FK → EquipoCatalogo
//   ~ Campo rival se mantiene en BD, oculto en UI (Opción B post-TFG)
//
// CHANGELOG v4.1 (04-may-2026):
//   ~ Corregidas relaciones entre PlantillaEvento y Evento
//   ~ Corregida auto-relación Evento (clonado)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum RolUsuario {
  UCO
  COORDINADOR
  VOLUNTARIO
  FACULTATIVO
  ALMACEN
  APOYO_INFORMATICO
  PROMOTOR
  EMPRESA_CONTRATADA
  EMPRESA_FACULTATIVOS
}

enum TipoEmpresa {
  PROMOTOR
  CONTRATADA
  FACULTATIVOS
}

enum EstadoDotacion {
  CL0_DISPONIBLE
  CL1_EN_CAMINO
  CL2_EN_INTERVENCION
  CL3_NO_DISPONIBLE
  CL5_SOLICITUD_AYUDA
  CL6_SITUACION_CONFLICTIVA
}

enum TipoPersona {
  VOLUNTARIO
  FACULTATIVO
}

enum GravedadIntervencion {
  LEVE
  MODERADA
  GRAVE
  CRITICA
}

enum EstadoWalkie {
  DISPONIBLE
  ASIGNADO
  AVERIADO
  BAJA
}

enum EstadoIntervencion {
  PENDIENTE_DOTACION
  EN_CURSO
  CERRADA
}

enum ResolucionIntervencion {
  ALTA_EN_LUGAR
  TRASLADO_CLINICA
  ALTA_EN_CLINICA
  TRASLADO_HOSPITALARIO
}

enum TipoMaterial {
  CONSUMIBLE
  REUTILIZABLE
  MEDICAMENTO
  EQUIPO
}

enum EstadoRevisionItem {
  OK
  FALTA
  DANADO
  CADUCADO
}

enum TipoAlerta {
  STOCK_BAJO
  CADUCIDAD_PROXIMA
  MATERIAL_DANADO
}

enum EstadoEvento {
  PENDIENTE
  ACTIVO
  FINALIZADO
}

enum TipoDotacion {
  AMBULANCIA
  BOTIQUIN
  UVI
  SVB
  CLINICA
  AVANZADA
  BANQUILLO
  LIMA
  UCO_UNIT
}

// =============================================================================
// EMPRESA
// =============================================================================

model Empresa {
  id            Int         @id @default(autoincrement())
  nombre        String      @db.VarChar(200)
  codigo        String      @unique @db.VarChar(3)
  tipo          TipoEmpresa
  telefono      String?     @db.VarChar(20)
  email         String?     @db.VarChar(255)
  contacto      String?     @db.VarChar(150)
  direccion     String?     @db.VarChar(300)
  cif           String?     @db.VarChar(20)
  observaciones String?     @db.Text
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  usuarios           UsuarioSistema[]
  eventosPromovidos  Evento[]          @relation("EventoPromotor")
  eventosContratados Evento[]          @relation("EventoContratada")
  plantillas         PlantillaEvento[]

  @@index([tipo])
  @@map("empresa")
}

// =============================================================================
// TIPO_EVENTO_CATALOGO
// =============================================================================

model TipoEventoCatalogo {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  codigo      String  @unique @db.VarChar(3)
  descripcion String? @db.VarChar(300)
  activo      Boolean @default(true)

  eventos    Evento[]
  plantillas PlantillaEvento[]

  @@map("tipo_evento_catalogo")
}

// =============================================================================
// UBICACION
// =============================================================================

model Ubicacion {
  id            Int     @id @default(autoincrement())
  nombre        String  @db.VarChar(200)
  codigo        String  @unique @db.VarChar(3)
  direccion     String  @db.VarChar(300)
  cp            String  @db.VarChar(10)
  poblacion     String  @db.VarChar(100)
  aforoMaximo   Int?    @map("aforo_maximo")
  observaciones String? @db.Text

  eventos    Evento[]
  contratos  Contrato[]
  plantillas PlantillaEvento[]

  @@map("ubicacion")
}

// =============================================================================
// PUESTO
// =============================================================================

model Puesto {
  id               Int     @id @default(autoincrement())
  nombre           String  @unique @db.VarChar(100)
  descripcion      String? @db.VarChar(500)
  requiereVehiculo Boolean @default(false) @map("requiere_vehiculo")

  posiciones              Posicion[]
  asignacionesMaterialTipo AsignacionMaterialPosicion[] @relation("TemplatePorPuesto")
  plantillaPosiciones     PlantillaPosicion[]

  @@map("puesto")
}

// =============================================================================
// SINTOMATOLOGIA
// =============================================================================

model Sintomatologia {
  id          Int     @id @default(autoincrement())
  tipo        String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(500)

  intervenciones Intervencion[]

  @@map("sintomatologia")
}

// =============================================================================
// CONTRATO
// =============================================================================

model Contrato {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(200)
  promotor      String   @db.VarChar(200)
  temporada     String   @db.VarChar(20)
  ubicacionId   Int?     @map("ubicacion_id")
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaFin      DateTime @map("fecha_fin") @db.Date
  observaciones String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ubicacion Ubicacion? @relation(fields: [ubicacionId], references: [id])
  eventos   Evento[]

  @@index([temporada])
  @@index([promotor])
  @@map("contrato")
}

// =============================================================================
// PLANTILLA_EVENTO
// Patrón nombre: [LOC 3]-[EVT 3]-[CTR 3]-[LIBRE 6]
// Ejemplo: BER-PLA-RMD-J5Oct
// =============================================================================

model PlantillaEvento {
  id           Int      @id @default(autoincrement())
  nombre       String   @unique @db.VarChar(20)
  codigoLoc    String   @db.VarChar(3)  @map("codigo_loc")
  codigoEvt    String   @db.VarChar(3)  @map("codigo_evt")
  codigoCtr    String   @db.VarChar(3)  @map("codigo_ctr")
  textoLibre   String   @db.VarChar(6)  @map("texto_libre")
  empresaId    Int      @map("empresa_id")
  tipoEventoId Int?     @map("tipo_evento_id")
  ubicacionId  Int?     @map("ubicacion_id")
  descripcion  String?  @db.Text
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  tipoEvento   TipoEventoCatalogo? @relation(fields: [tipoEventoId], references: [id])
  ubicacion    Ubicacion?          @relation(fields: [ubicacionId], references: [id])
  posiciones   PlantillaPosicion[]
  /// Eventos creados usando esta plantilla como base (Opción B)
  eventos      Evento[]            @relation("EventoDesdePlantilla")

  @@index([empresaId])
  @@index([tipoEventoId])
  @@index([ubicacionId])
  @@map("plantilla_evento")
}

// =============================================================================
// PLANTILLA_POSICION
// =============================================================================

model PlantillaPosicion {
  id             Int     @id @default(autoincrement())
  plantillaId    Int     @map("plantilla_id")
  puestoId       Int     @map("puesto_id")
  nombreSugerido String? @db.VarChar(100) @map("nombre_sugerido")
  personalMinimo Int     @default(2) @map("personal_minimo")
  sector         String? @db.VarChar(100)
  observaciones  String? @db.VarChar(300)

  plantilla PlantillaEvento @relation(fields: [plantillaId], references: [id])
  puesto    Puesto          @relation(fields: [puestoId], references: [id])

  @@index([plantillaId])
  @@map("plantilla_posicion")
}

// =============================================================================
// USUARIO_SISTEMA
// =============================================================================

model UsuarioSistema {
  id             Int        @id @default(autoincrement())
  email          String     @unique @db.VarChar(255)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  nombreCompleto String     @map("nombre_completo") @db.VarChar(150)
  rol            RolUsuario
  empresaId      Int?       @map("empresa_id")
  activo         Boolean    @default(true)
  fechaRegistro  DateTime   @default(now()) @map("fecha_registro")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  empresa           Empresa?            @relation(fields: [empresaId], references: [id])
  eventosComoUco    Evento[]            @relation("EventoUCO")
  intervencionesUco Intervencion[]      @relation("IntervencionUCO")
  revisionesMat     RevisionMaterial[]
  estadosLog        EstadoDotacionLog[]

  @@index([rol])
  @@index([empresaId])
  @@map("usuario_sistema")
}

// =============================================================================
// EVENTO
// =============================================================================

model Evento {
  id                    Int       @id @default(autoincrement())
  nombre                String    @db.VarChar(200)
  ubicacionId           Int       @map("ubicacion_id")
  fecha                 DateTime  @db.Date
  tipoEventoId          Int?      @map("tipo_evento_id")
  rival                 String?   @db.VarChar(200)
  equipoLocalId     Int?    @map("equipo_local_id")
  equipoVisitanteId Int?    @map("equipo_visitante_id")
  aforoPrevisto         Int?      @map("aforo_previsto")
  aforoEstimado         Int?      @map("aforo_estimado")
  contratoId            Int?      @map("contrato_id")
  temporada             String?   @db.VarChar(20)
  empresaPromotorId     Int?      @map("empresa_promotor_id")
  empresaContratadaId   Int?      @map("empresa_contratada_id")
  /// FK a la plantilla desde la que se creó (Opción B)
  plantillaOrigenId     Int?      @map("plantilla_origen_id")
  /// FK al evento del que se clonó (Opción A)
  eventoOrigenId        Int?      @map("evento_origen_id")
  horaIncorporacionSspp DateTime? @map("hora_incorporacion_sspp")
  horaFinalizacionSspp  DateTime? @map("hora_finalizacion_sspp")
  horaInicioEvento      String?   @map("hora_inicio_evento") @db.VarChar(5)
  horaFinEvento         String?   @map("hora_fin_evento") @db.VarChar(5)
  horaInicioUco         DateTime? @map("hora_inicio_uco")
  directorMedico        String?   @map("director_medico") @db.VarChar(150)
  promotor              String?   @db.VarChar(200)
  coordinadorUcoId      Int?      @map("coordinador_uco_id")
  temperaturaClin       Decimal?  @map("temperatura_clinica") @db.Decimal(4, 1)
  observaciones         String?   @db.Text
  deletedAt             DateTime? @map("deleted_at")
  estado                EstadoEvento @default(PENDIENTE)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  ubicacion          Ubicacion           @relation(fields: [ubicacionId], references: [id])
  contrato           Contrato?           @relation(fields: [contratoId], references: [id])
  tipoEvento         TipoEventoCatalogo? @relation(fields: [tipoEventoId], references: [id])
  empresaPromotor    Empresa?            @relation("EventoPromotor", fields: [empresaPromotorId], references: [id])
  empresaContratada  Empresa?            @relation("EventoContratada", fields: [empresaContratadaId], references: [id])
  equipoLocal       EquipoCatalogo? @relation("EventoLocal",     fields: [equipoLocalId],     references: [id])
  equipoVisitante   EquipoCatalogo? @relation("EventoVisitante", fields: [equipoVisitanteId], references: [id])
  /// Plantilla de origen (Opción B)
  plantillaOrigen    PlantillaEvento?    @relation("EventoDesdePlantilla", fields: [plantillaOrigenId], references: [id])
  /// Evento del que se clonó (Opción A) — auto-relación
  eventoOrigen       Evento?             @relation("EventoClonadoDe", fields: [eventoOrigenId], references: [id])
  /// Eventos que se han clonado de este (auto-relación inversa)
  eventosClonados    Evento[]            @relation("EventoClonadoDe")
  coordinadorUco     UsuarioSistema?     @relation("EventoUCO", fields: [coordinadorUcoId], references: [id])
  posiciones         Posicion[]
  dotaciones         Dotacion[]
  intervenciones     Intervencion[]
  revisionesMat      RevisionMaterial[]
  asignacionesWalkie AsignacionWalkie[]

  @@index([fecha])
  @@index([tipoEventoId])
  @@index([ubicacionId])
  @@index([contratoId])
  @@index([temporada])
  @@index([empresaContratadaId])
  @@map("evento")
}

// =============================================================================
// POSICION
// =============================================================================

model Posicion {
  id                Int     @id @default(autoincrement())
  eventoId          Int     @map("evento_id")
  nombre            String  @db.VarChar(100)
  codigoQr          String  @unique @map("codigo_qr") @db.VarChar(100)
  puestoId          Int     @map("puesto_id")
  sector            String? @db.VarChar(100)
  capacidadPersonas Int?    @map("capacidad_personas")

  evento                 Evento                      @relation(fields: [eventoId], references: [id])
  puesto                 Puesto                      @relation(fields: [puestoId], references: [id])
  dotacion               Dotacion?
  revisiones             RevisionMaterial[]
  asignacionesMat        AsignacionMaterialPosicion[] @relation("AsignacionPorPosicion")
  intervencionesDestino  Intervencion[]              @relation("ClinicaDestino")

  @@index([eventoId])
  @@index([codigoQr])
  @@index([puestoId])
  @@map("posicion")
}

// =============================================================================
// DOTACION
// =============================================================================

model Dotacion {
  id             Int            @id @default(autoincrement())
  eventoId       Int            @map("evento_id")
  codigo         String         @db.VarChar(50)
  posicionId     Int?           @unique @map("posicion_id")
  tipo           TipoDotacion
  personalMinimo Int            @default(2) @map("personal_minimo")
  estado         EstadoDotacion @default(CL0_DISPONIBLE)
  indicativo     String?        @db.VarChar(50)
  numDues        Int            @default(0) @map("num_dues")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  evento                 Evento                       @relation(fields: [eventoId], references: [id])
  posicion               Posicion?                    @relation(fields: [posicionId], references: [id])
  personal               AsignacionPersonalDotacion[]
  walkies                AsignacionWalkie[]
  asignacionesMaterial   AsignacionMaterialDotacion[]
  intervencionesActivas  Intervencion[]               @relation("DotacionActiva")
  intervencionesApoyo    Intervencion[]               @relation("DotacionApoyo")
  intervencionesTraslado Intervencion[]               @relation("DotacionTraslado")
  estadosLog             EstadoDotacionLog[]

  @@unique([eventoId, codigo])
  @@index([eventoId])
  @@index([estado])
  @@map("dotacion")
}

// =============================================================================
// TITULACION_CATALOGO
// =============================================================================

/// Catálogo de titulaciones sanitarias seleccionables
/// para el registro de personal (v4.3).
model TitulacionCatalogo {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.VarChar(300)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  personas Persona[]

  @@index([activo])
  @@index([orden])
  @@map("titulacion_catalogo")
}

// =============================================================================
// PERSONA
// =============================================================================

model Persona {
  id             Int         @id @default(autoincrement())
  nombreCompleto String      @map("nombre_completo") @db.VarChar(150)
  email          String      @unique @db.VarChar(255)
  telefono       String?     @db.VarChar(20)
  tipo           TipoPersona
  titulacionId   Int?        @map("titulacion_id")
  acreditacion   String?     @db.VarChar(100)
  activo         Boolean     @default(true)
  observaciones  String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  titulacion   TitulacionCatalogo? @relation(fields: [titulacionId], references: [id])
  asignaciones AsignacionPersonalDotacion[]

  @@index([tipo])
  @@index([activo])
  @@map("persona")
}

// =============================================================================
// ASIGNACION_PERSONAL_DOTACION
// =============================================================================

model AsignacionPersonalDotacion {
  id              Int       @id @default(autoincrement())
  dotacionId      Int       @map("dotacion_id")
  personaId       Int       @map("persona_id")
  rolEnDotacion   String    @map("rol_en_dotacion") @db.VarChar(60)
  turnoInicioPrev DateTime? @map("turno_inicio_prev")
  turnoFinPrev    DateTime? @map("turno_fin_prev")
  asiste          Boolean?
  turnoInicioReal DateTime? @map("turno_inicio_real")
  turnoFinReal    DateTime? @map("turno_fin_real")
  observaciones   String?   @db.VarChar(300)
  createdAt       DateTime  @default(now()) @map("created_at")

  dotacion Dotacion @relation(fields: [dotacionId], references: [id])
  persona  Persona  @relation(fields: [personaId], references: [id])

  @@unique([dotacionId, personaId])
  @@index([dotacionId])
  @@index([personaId])
  @@map("asignacion_personal_dotacion")
}

// =============================================================================
// INTERVENCION
// =============================================================================

model Intervencion {
  id                  Int                     @id @default(autoincrement())
  eventoId            Int                     @map("evento_id")
  numeroIntervencion  Int                     @map("numero_intervencion")
  horaAviso           DateTime?               @map("hora_aviso")
  horaLlegada         DateTime?               @map("hora_llegada")
  horaFinal           DateTime?               @map("hora_final")
  dotacionActivaId    Int?                    @map("dotacion_activa_id")
  dotacionApoyoId     Int?                    @map("dotacion_apoyo_id")
  sintomatologiaId    Int                     @map("sintomatologia_id")
  gravedad            GravedadIntervencion    @default(LEVE)
  estado              EstadoIntervencion      @default(PENDIENTE_DOTACION)
  uco                 String                  @default("UCO1") @db.VarChar(10)
  sector              String?                 @db.VarChar(100)
  resolucion          ResolucionIntervencion?
  lugar               String?                 @db.VarChar(100)
  altaEnLugar         Boolean                 @default(false) @map("alta_en_lugar")
  trasladoClinica     Boolean                 @default(false) @map("traslado_clinica")
  clinicaDestinoId    Int?                    @map("clinica_destino_id")
  altaEnClinica       Boolean                 @default(false) @map("alta_en_clinica")
  trasladoHospital    Boolean                 @default(false) @map("traslado_hospital")
  hospitalDestino     String?                 @map("hospital_destino") @db.VarChar(150)
  dotacionTrasladoId  Int?                    @map("dotacion_traslado_id")
  usuarioUcoId        Int?                    @map("usuario_uco_id")
  observaciones       String?                 @db.Text
  parte               String?                 @db.VarChar(50)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  evento           Evento           @relation(fields: [eventoId], references: [id])
  sintomatologia   Sintomatologia   @relation(fields: [sintomatologiaId], references: [id])
  dotacionActiva   Dotacion?        @relation("DotacionActiva", fields: [dotacionActivaId], references: [id])
  dotacionApoyo    Dotacion?        @relation("DotacionApoyo", fields: [dotacionApoyoId], references: [id])
  dotacionTraslado Dotacion?        @relation("DotacionTraslado", fields: [dotacionTrasladoId], references: [id])
  clinicaDestino   Posicion?        @relation("ClinicaDestino", fields: [clinicaDestinoId], references: [id])
  usuarioUco       UsuarioSistema?  @relation("IntervencionUCO", fields: [usuarioUcoId], references: [id])

  @@unique([eventoId, numeroIntervencion])
  @@index([eventoId])
  @@index([dotacionActivaId])
  @@index([sintomatologiaId])
  @@index([createdAt])
  @@map("intervencion")
}

// =============================================================================
// WALKIE
// =============================================================================

model Walkie {
  id            Int          @id @default(autoincrement())
  numero        String       @unique @db.VarChar(20)
  estado        EstadoWalkie @default(DISPONIBLE)
  observaciones String?      @db.VarChar(300)
  createdAt     DateTime     @default(now()) @map("created_at")

  asignaciones AsignacionWalkie[]

  @@map("walkie")
}

// =============================================================================
// ASIGNACION_WALKIE
// =============================================================================

model AsignacionWalkie {
  id              Int       @id @default(autoincrement())
  walkieId        Int       @map("walkie_id")
  dotacionId      Int       @map("dotacion_id")
  eventoId        Int       @map("evento_id")
  fechaAsignacion DateTime  @default(now()) @map("fecha_asignacion")
  fechaDevolucion DateTime? @map("fecha_devolucion")
  devuelto        Boolean   @default(false)

  walkie   Walkie   @relation(fields: [walkieId], references: [id])
  dotacion Dotacion @relation(fields: [dotacionId], references: [id])
  evento   Evento   @relation(fields: [eventoId], references: [id])

  @@unique([walkieId, eventoId])
  @@index([dotacionId, eventoId])
  @@map("asignacion_walkie")
}

// =============================================================================
// MATERIAL
// =============================================================================

model Material {
  id               Int          @id @default(autoincrement())
  codigo           String       @unique @db.VarChar(50)
  nombre           String       @db.VarChar(200)
  tipo             TipoMaterial
  unidadMedida     String       @default("unidades") @map("unidad_medida") @db.VarChar(30)
  stockActual      Int          @default(0) @map("stock_actual")
  stockMinimo      Int          @default(0) @map("stock_minimo")
  precioUnitario   Decimal?     @map("precio_unitario") @db.Decimal(10, 2)
  codigoAlmacen    String?      @map("codigo_almacen") @db.VarChar(100)
  ubicacionAlmacen String?      @map("ubicacion_almacen") @db.VarChar(100)
  referenciaBase   String?      @map("referencia_base") @db.VarChar(50)
  proveedor        String?      @db.VarChar(200)
  fechaCaducidad   DateTime?    @map("fecha_caducidad") @db.Date
  lote             String?      @db.VarChar(100)
  esCritico        Boolean      @default(false) @map("es_critico")
  activo           Boolean      @default(true)
  observaciones    String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  asignacionesPosicion AsignacionMaterialPosicion[] @relation("AsignacionPorMaterial")
  asignacionesDotacion AsignacionMaterialDotacion[] @relation("AsignacionPorMaterialDotacion")
  detallesRevision     DetalleRevisionMaterial[]
  alertas              AlertaMaterial[]

  @@index([tipo])
  @@index([fechaCaducidad])
  @@index([esCritico])
  @@map("material")
}

// =============================================================================
// ASIGNACION_MATERIAL_POSICION
// =============================================================================

model AsignacionMaterialPosicion {
  id               Int     @id @default(autoincrement())
  posicionId       Int?    @map("posicion_id")
  materialId       Int     @map("material_id")
  cantidadEsperada Int     @map("cantidad_esperada")
  esObligatorio    Boolean @default(true) @map("es_obligatorio")
  puestoId         Int?    @map("puesto_id")

  posicion Posicion? @relation("AsignacionPorPosicion", fields: [posicionId], references: [id])
  material Material  @relation("AsignacionPorMaterial", fields: [materialId], references: [id])
  puesto   Puesto?   @relation("TemplatePorPuesto", fields: [puestoId], references: [id])

  @@unique([posicionId, materialId])
  @@index([materialId])
  @@index([puestoId])
  @@map("asignacion_material_posicion")
}

// =============================================================================
// ASIGNACION_MATERIAL_DOTACION
// =============================================================================

/// Asignación de material a dotaciones individuales.
/// Distinta de AsignacionMaterialPosicion que asigna material a posiciones fijas del recinto.
model AsignacionMaterialDotacion {
  id            Int      @id @default(autoincrement())
  dotacionId    Int      @map("dotacion_id")
  materialId    Int      @map("material_id")
  cantidad      Int      @default(1)
  observaciones String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dotacion Dotacion @relation(fields: [dotacionId], references: [id])
  material Material @relation("AsignacionPorMaterialDotacion", fields: [materialId], references: [id])

  @@unique([dotacionId, materialId])
  @@index([dotacionId])
  @@map("asignacion_material_dotacion")
}

// =============================================================================
// REVISION_MATERIAL
// =============================================================================

model RevisionMaterial {
  id                      Int      @id @default(autoincrement())
  eventoId                Int      @map("evento_id")
  posicionId              Int      @map("posicion_id")
  usuarioId               Int      @map("usuario_id")
  fechaHora               DateTime @default(now()) @map("fecha_hora")
  porcentajeOperatividad  Int      @default(100) @map("porcentaje_operatividad")
  observaciones           String?  @db.Text

  evento   Evento         @relation(fields: [eventoId], references: [id])
  posicion Posicion       @relation(fields: [posicionId], references: [id])
  usuario  UsuarioSistema @relation(fields: [usuarioId], references: [id])
  detalles DetalleRevisionMaterial[]

  @@index([eventoId, posicionId])
  @@index([fechaHora])
  @@map("revision_material")
}

// =============================================================================
// DETALLE_REVISION_MATERIAL
// =============================================================================

model DetalleRevisionMaterial {
  id               Int                @id @default(autoincrement())
  revisionId       Int                @map("revision_id")
  materialId       Int                @map("material_id")
  cantidadEsperada Int                @map("cantidad_esperada")
  cantidadReal     Int                @map("cantidad_real")
  estado           EstadoRevisionItem
  observaciones    String?            @db.VarChar(300)

  revision RevisionMaterial @relation(fields: [revisionId], references: [id])
  material Material         @relation(fields: [materialId], references: [id])

  @@index([revisionId])
  @@map("detalle_revision_material")
}

// =============================================================================
// ALERTA_MATERIAL [POST-MVP]
// =============================================================================

model AlertaMaterial {
  id                Int        @id @default(autoincrement())
  materialId        Int        @map("material_id")
  tipoAlerta        TipoAlerta @map("tipo_alerta")
  descripcion       String?    @db.VarChar(300)
  fechaGenerada     DateTime   @default(now()) @map("fecha_generada")
  resuelta          Boolean    @default(false)
  fechaResolucion   DateTime?  @map("fecha_resolucion")
  usuarioResuelveId Int?       @map("usuario_resuelve_id")

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId, resuelta])
  @@map("alerta_material")
}

// =============================================================================
// ESTADO_DOTACION_LOG [POST-MVP]
// =============================================================================

model EstadoDotacionLog {
  id              Int            @id @default(autoincrement())
  dotacionId      Int            @map("dotacion_id")
  estadoAnterior  EstadoDotacion @map("estado_anterior")
  estadoNuevo     EstadoDotacion @map("estado_nuevo")
  fechaHoraCambio DateTime       @default(now()) @map("fecha_hora_cambio")
  motivo          String?        @db.VarChar(300)
  usuarioId       Int?           @map("usuario_id")

  dotacion Dotacion        @relation(fields: [dotacionId], references: [id])
  usuario  UsuarioSistema? @relation(fields: [usuarioId], references: [id])

  @@index([dotacionId])
  @@map("estado_dotacion_log")
}

/// Catálogo de equipos deportivos para eventos con participantes conocidos.
/// Permite seleccionar equipo local y visitante en lugar de texto libre (rival).
/// El campo rival se mantiene en Evento para compatibilidad con datos históricos.
model EquipoCatalogo {
  id      Int     @id @default(autoincrement())
  nombre  String  @db.VarChar(200)
  codigo  String  @unique @db.VarChar(5)
  deporte String  @db.VarChar(50)
  activo  Boolean @default(true)

  eventosComoLocal     Evento[] @relation("EventoLocal")
  eventosComoVisitante Evento[] @relation("EventoVisitante")

  @@index([deporte])
  @@index([activo])
  @@map("equipo_catalogo")
}
